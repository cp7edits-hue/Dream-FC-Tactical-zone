# GEMINI_API_KEY: Optional if server-side AI analysis is requested.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g. http://localhost:3000 in dev)
APP_URL="http://localhost:3000"

# --- SUPABASE CONFIGURATION (POSTGRESQL & AUTH) ---
# Supabase project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL="https://YOUR_SUPABASE_PROJECT_ID.supabase.co"
VITE_SUPABASE_URL="https://YOUR_SUPABASE_PROJECT_ID.supabase.co"

# Supabase Public Anon Key (safe for client queries with Row Level Security)
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Supabase Service Role Key (SERVER-ONLY - NEVER EXPOSE TO CLIENT)
# Used exclusively inside server-side route handlers for privileged administrative actions
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# --- LIVEKIT WEBRTC CONFIGURATION (AUDIO / VIDEO) ---
# LiveKit Cloud WebSocket URL (e.g. wss://dreamfc-xyz.livekit.cloud)
LIVEKIT_URL="wss://YOUR_LIVEKIT_PROJECT.livekit.cloud"
VITE_LIVEKIT_URL="wss://YOUR_LIVEKIT_PROJECT.livekit.cloud"

# LiveKit Server Credentials (SERVER-ONLY - used to generate short-lived participant access tokens)
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"

# --- APPLICATION SECURITY ---
# High-entropy random string for signing session cookies
SESSION_SECRET="CHANGE_ME_TO_A_SECURE_RANDOM_64_CHAR_SECRET"

# Port (default 3000)
PORT=3000
